{
  "tasks": {
    "start": "deno run --env-file=.env --allow-env --allow-net scripts/serve.ts",
    "check": "deno check src/*.ts scripts/*.ts tests/*.ts supabase/functions/hidden-jobs-mcp/index.ts",
    "fmt": "deno fmt --check src scripts tests deno.json docs/deployment.md docs/backend-contract.md CONTRIBUTING.md supabase/functions/hidden-jobs-mcp/index.ts",
    "test": "deno test --allow-env tests/",
    "smoke": "deno run --allow-env --allow-net --allow-read scripts/smoke-test.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true
  }
}
