# Public connection used by the smoke check.
HIDDEN_JOBS_MCP_URL=https://hiddenjobs.dev/mcp

# Server-side development settings. Fill these before running deno task start.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JOBS_TABLE=jobs
MCP_RESOURCE_URL=https://hiddenjobs.dev/mcp
# Defaults to SUPABASE_URL/auth/v1 when omitted.
# OAUTH_ISSUER=https://identity.example.com/auth/v1
HOST=127.0.0.1
PORT=8000

# Optional authenticated smoke check: path to a private OAuth access-token file.
# HIDDEN_JOBS_OAUTH_TOKEN_FILE=/absolute/path/to/access-token.txt
# CHECK_APPLICATION_LINK=true
